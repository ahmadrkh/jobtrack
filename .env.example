# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit actual secrets.

# ── Database (Neon Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth core ─────────────────────────────────────────────────────────
# NEXTAUTH_URL MUST exactly match the domain you visit
# (production Vercel URL, or http://localhost:3000 in dev). A mismatch is the
# usual cause of the GitHub "redirect_uri is not associated" error.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── GitHub OAuth ──────────────────────────────────────────────────────────
# github.com/settings/developers → OAuth App.
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ── Google OAuth ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email reminders (Resend) + Vercel Cron ────────────────────────────────
RESEND_API_KEY=""
CRON_SECRET=""

# ── Resume upload (Vercel Blob) ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
