# Dependencies — never committed, always regenerated via npm install
node_modules/

# Next.js build output — generated by `next build`, not source code
.next/
out/

# TypeScript incremental build cache — regenerated by tsc, not source
*.tsbuildinfo

# Environment variables — MAY contain secrets, never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# SQLite database — it's data, not code. In production you'd use
# a hosted Postgres and never have a .db file in the repo.
*.db
*.db-journal

# Prisma generated client — regenerated by `prisma generate`
# (some teams do commit this; leaving it out keeps the repo clean)
# node_modules/@prisma/client is already covered above

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
playwright-report/
test-results/
